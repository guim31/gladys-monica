    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Reads Monica now and reports what it finds.",
        "fr": "Lit Monica maintenant et indique ce qu'il trouve.",
        "de": "Liest Monica sofort und meldet, was es findet.",
        "es": "Lee Monica ahora e indica lo que encuentra."
      },
      "timeout_seconds": 60
    }
  ],
  "scene_triggers": [
    {
      "key": "birthday_today",
      "label": {
        "en": "Birthday today (Monica)",
        "fr": "Anniversaire aujourd'hui (Monica)",
        "de": "Geburtstag heute (Monica)",
        "es": "Cumpleaños hoy (Monica)"
      },
      "description": {
        "en": "A contact has a birthday today. Fires once, at the time set in the configuration.",
        "fr": "Un contact fête son anniversaire aujourd'hui. Une fois, à l'heure réglée dans la configuration.",
        "de": "Ein Kontakt hat heute Geburtstag. Einmal, zur in der Konfiguration eingestellten Uhrzeit.",
        "es": "Un contacto cumple años hoy. Una vez, a la hora configurada."
      },
      "fields": [
        {
          "key": "name",
          "type": "string",
          "label": {
            "en": "Name (empty: anyone)",
            "fr": "Nom (vide : tout le monde)",
            "de": "Name (leer: alle)",
            "es": "Nombre (vacío: cualquiera)"
          },
          "description": {
            "en": "First and last name exactly as in Monica.",
            "fr": "Prénom et nom exactement comme dans Monica.",
            "de": "Vor- und Nachname genau wie in Monica.",
            "es": "Nombre y apellido exactamente como en Monica."
          }
        }
      ],
      "variables": [
        {
          "key": "name",
          "type": "string",
          "label": {
            "en": "Name",
            "fr": "Nom",
            "de": "Name",
            "es": "Nombre"
          }
        },
        {
          "key": "first_name",
          "type": "string",
          "label": {
            "en": "First name",
            "fr": "Prénom",
            "de": "Vorname",
            "es": "Nombre de pila"
          }
        },
        {
          "key": "age",
          "type": "number",
          "label": {
            "en": "Age turned (empty if the year is unknown)",
            "fr": "Âge atteint (vide si l'année est inconnue)",
            "de": "Erreichtes Alter (leer, wenn das Jahr unbekannt ist)",
            "es": "Edad cumplida (vacía si se desconoce el año)"
          }
        },
        {
          "key": "date",
          "type": "string",
          "label": {
            "en": "Birthday date (YYYY-MM-DD)",
            "fr": "Date de l'anniversaire (AAAA-MM-JJ)",
            "de": "Datum des Geburtstags (JJJJ-MM-TT)",
            "es": "Fecha del cumpleaños (AAAA-MM-DD)"
          }
        },
        {
          "key": "contact_id",
          "type": "number",
          "label": {
            "en": "Monica contact number",
            "fr": "Numéro du contact Monica",
            "de": "Nummer des Monica-Kontakts",
            "es": "Número del contacto de Monica"
          }
        }
      ]
    },
    {
      "key": "birthday_upcoming",
