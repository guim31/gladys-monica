{
  "manifest_version": 1,
  "type": "device",
  "name": "Monica",
  "description": {
    "en": "Monica (personal CRM) birthdays and reminders: counters, scene triggers, a widget.",
    "fr": "Anniversaires et rappels de Monica (CRM personnel) : compteurs, déclencheurs de scène, widget.",
    "de": "Geburtstage und Erinnerungen aus Monica (persönliches CRM): Zähler, Szenenauslöser, Widget.",
    "es": "Cumpleaños y recordatorios de Monica (CRM personal): contadores, disparadores de escena, widget."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-monica:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-monica/main/cover.png",
  "categories": ["services"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your Monica",
        "fr": "Votre Monica",
        "de": "Dein Monica",
        "es": "Su Monica"
      },
      "description": {
        "en": "A self-hosted Monica 4 (Monica 5 has no API yet). In Monica, create a personal access token: Settings, API, Personal access tokens.",
        "fr": "Un Monica 4 auto-hébergé (Monica 5 n'a pas encore d'API). Dans Monica, créez un jeton d'accès personnel : Settings, API, Personal access tokens.",
        "de": "Ein selbst gehostetes Monica 4 (Monica 5 hat noch keine API). Erstelle in Monica ein persönliches Zugriffstoken: Settings, API, Personal access tokens.",
        "es": "Un Monica 4 autoalojado (Monica 5 aún no tiene API). En Monica, cree un token de acceso personal: Settings, API, Personal access tokens."
      },
      "links": [
        {
          "url": "https://github.com/monicahq/monica/blob/4.x/docs/api/index.md",
          "label": {
            "en": "Monica API documentation",
            "fr": "Documentation de l'API Monica",
            "de": "Dokumentation der Monica-API",
            "es": "Documentación de la API de Monica"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "Address",
        "fr": "Adresse",
        "de": "Adresse",
        "es": "Dirección"
      },
      "description": {
        "en": "Address of Monica, as in the browser, with https:// for HTTPS and :port if not the default.",
        "fr": "Adresse de Monica, comme dans le navigateur, avec https:// pour le HTTPS et :port s'il n'est pas standard.",
        "de": "Adresse von Monica wie im Browser, mit https:// für HTTPS und :Port, falls nicht Standard.",
        "es": "Dirección de Monica, como en el navegador, con https:// para HTTPS y :puerto si no es el estándar."
      },
      "placeholder": {
        "en": "e.g. http://192.168.1.20:8080",
        "fr": "ex. http://192.168.1.20:8080",
        "de": "z. B. http://192.168.1.20:8080",
        "es": "p. ej. http://192.168.1.20:8080"
      },
      "required": true,
      "default": ""
    },
    {
      "key": "api_token",
      "type": "secret",
      "label": {
        "en": "Personal access token",
        "fr": "Jeton d'accès personnel",
        "de": "Persönliches Zugriffstoken",
        "es": "Token de acceso personal"
      },
      "description": {
        "en": "Created in Monica: Settings, API, Personal access tokens. Read only by the integration.",
        "fr": "Créé dans Monica : Settings, API, Personal access tokens. L'intégration ne fait que lire.",
        "de": "Erstellt in Monica: Settings, API, Personal access tokens. Die Integration liest nur.",
        "es": "Creado en Monica: Settings, API, Personal access tokens. La integración solo lee."
      },
      "required": true
    },
    {
      "key": "options",
      "type": "section",
      "label": {
        "en": "Options",
        "fr": "Options",
        "de": "Optionen",
        "es": "Opciones"
      }
    },
    {
      "key": "event_hour",
      "type": "select",
      "label": {
        "en": "Time of the scene events",
        "fr": "Heure des événements de scène",
        "de": "Uhrzeit der Szenenereignisse",
        "es": "Hora de los eventos de escena"
