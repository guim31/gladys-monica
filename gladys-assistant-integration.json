    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often Monica is read. Midnight and the time of the events are always followed on time.",
        "fr": "Fréquence de lecture de Monica. Minuit et l'heure des événements sont toujours suivis à l'heure.",
        "de": "Wie oft Monica gelesen wird. Mitternacht und die Uhrzeit der Ereignisse werden immer pünktlich berücksichtigt.",
        "es": "Con qué frecuencia se lee Monica. La medianoche y la hora de los eventos se siguen siempre a tiempo."
      },
      "required": false,
      "default": "60",
      "options": [
        {
          "value": "15",
          "label": {
            "en": "15 minutes",
            "fr": "15 minutes",
            "de": "15 Minuten",
            "es": "15 minutos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 minutes",
            "fr": "30 minutes",
            "de": "30 Minuten",
            "es": "30 minutos"
          }
        },
        {
          "value": "60",
          "label": {
